{
  "schema_version": 1,
  "title": "Banto repo-ontology TBox",
  "_note": "Vocabulary (entity types + relation types) for the repo ontology. The ABox (per-repo facts) lives in {base}/meta/ontology.{json,md}, generated by ontology-gen.sh and verified by ontology-lint.sh. Modular by design: `core` applies to every repo; `code-layer` to source repos (v2 symbol layer, ctags/tree-sitter); `harness-layer` to banto + repos using banto (v1 main). The harness-layer is a single schema shared by three consumers — ontology-lint (enforce), plugin-audit (surface), plugin-dev (prevent). store-layout.json is the store-bucket sub-schema. Rationale: docs '[Design] harness-ontology-seed-abox-and-modular-tbox-2026-06-29' §4; decisions 2026-06-29-220931 / 2026-06-29-221925 / 2026-07-01-082355.",
  "modules": {
    "core": {
      "applies_to": "every repo (always emitted; graceful when no analysis tool is present)",
      "entities": [
        { "type": "repo", "id_prefix": "repo:", "attributes": ["name"] },
        { "type": "directory", "id_prefix": "dir:", "attributes": ["path"] },
        { "type": "file", "id_prefix": "file:", "attributes": ["path", "lang"] },
        { "type": "module", "id_prefix": "module:", "attributes": ["path"] },
        { "type": "external-dep", "id_prefix": "dep:", "attributes": ["name", "ecosystem", "version"] }
      ],
      "relations": [
        { "type": "contains", "from": ["repo", "directory", "module"], "to": ["directory", "file", "module"] },
        { "type": "documented-in", "from": ["repo", "module", "directory"], "to": ["file"] },
        { "type": "references", "from": ["file", "module"], "to": ["file", "module", "external-dep"] },
        { "type": "depends-on", "from": ["repo", "module"], "to": ["external-dep"] }
      ]
    },
    "code-layer": {
      "applies_to": "source-code repos (v2; ctags / tree-sitter symbol layer). banto itself has little use for this.",
      "status": "deferred-to-v2",
      "entities": [
        { "type": "symbol", "id_prefix": "sym:", "attributes": ["name", "kind", "file", "lang"], "note": "function / class / method" }
      ],
      "relations": [
        { "type": "imports", "from": ["file", "symbol"], "to": ["file", "symbol", "external-dep"] },
        { "type": "calls", "from": ["symbol"], "to": ["symbol"] },
        { "type": "defines", "from": ["file"], "to": ["symbol"] }
      ]
    },
    "harness-layer": {
      "applies_to": "banto + repos using banto (v1 MAIN). Extracted from harness manifests with grep/jq/sh (no ctags).",
      "entities": [
        { "type": "skill", "id_prefix": "skill:", "attributes": ["autonomy", "user_invocable"], "source": "skills/<name>/SKILL.md + odd.yaml" },
        { "type": "agent", "id_prefix": "agent:", "attributes": ["tools", "invoked_by"], "source": "agents/<name>.md" },
        { "type": "hook", "id_prefix": "hook:", "attributes": ["event", "matcher", "strength", "registered"], "source": "hooks/*.sh registered in hooks.json" },
        { "type": "rule", "id_prefix": "rule:", "attributes": ["enforcement"], "source": "templates/rules/*.md (deployed to ~/.claude/rules/)" },
        { "type": "odd-policy", "id_prefix": "odd:", "attributes": ["autonomy_level", "skill"], "source": "skills/<name>/odd.yaml" },
        { "type": "script", "id_prefix": "script:", "attributes": ["path"], "source": "scripts/*.sh not registered as hooks (helpers)" },
        { "type": "workflow", "id_prefix": "workflow:", "attributes": ["path"], "source": "workflows/*.workflow.js" },
        { "type": "tool", "id_prefix": "tool:", "attributes": ["kind"], "note": "built-in (Read/Grep/Bash/Agent/...) or MCP" },
        { "type": "command", "id_prefix": "command:", "attributes": ["slash"], "note": "slash alias of a skill" },
        { "type": "event", "id_prefix": "event:", "attributes": ["matcher"], "note": "PreToolUse/PostToolUse/SessionStart/Stop/PreCompact/SessionEnd (+ matcher)" },
        { "type": "model", "id_prefix": "model:", "attributes": ["tier"], "note": "opus / sonnet / haiku" },
        { "type": "store-bucket", "id_prefix": "bucket:", "attributes": ["sub_path", "scope", "gitignore"], "source": "templates/store-layout.json (sub-schema)" },
        { "type": "agent-memory", "id_prefix": "amem:", "attributes": ["scope"] },
        { "type": "branch", "id_prefix": "branch:", "attributes": ["tier"], "note": "main / epic / task" },
        { "type": "worktree", "id_prefix": "worktree:", "attributes": ["path"] },
        { "type": "env-flag", "id_prefix": "env:", "attributes": ["name"], "note": "BANTO_ALLOW_* escape hatch" }
      ],
      "relation_categories": {
        "data": [
          { "type": "reads", "from": ["skill", "agent", "hook"], "to": ["store-bucket", "file"] },
          { "type": "writes-to", "from": ["skill", "agent", "hook"], "to": ["store-bucket", "file"] },
          { "type": "owns", "from": ["skill"], "to": ["file", "store-bucket"] }
        ],
        "orchestration": [
          { "type": "invokes", "from": ["skill"], "to": ["skill"], "note": "skill -> skill" },
          { "type": "delegates-to", "from": ["skill"], "to": ["agent"], "note": "skill -> subagent" },
          { "type": "spawns-parallel", "from": ["skill"], "to": ["agent"], "attributes": ["cardinality", "model"] },
          { "type": "hands-off-to", "from": ["skill"], "to": ["skill"], "note": "pipeline handoff" },
          { "type": "escalates-to", "from": ["skill"], "to": ["skill"], "attributes": ["condition"] },
          { "type": "specializes", "from": ["skill"], "to": ["skill"], "note": "inheritance (ai-build/model-lab -> dev-loop)" },
          { "type": "uses-tool", "from": ["agent", "skill"], "to": ["tool"] }
        ],
        "negative_routing": [
          { "type": "excludes", "from": ["skill"], "to": ["skill"], "note": "\"do not use when\"" },
          { "type": "defers-to", "from": ["skill"], "to": ["skill"] }
        ],
        "enforcement": [
          { "type": "enforces", "from": ["hook"], "to": ["rule"], "attributes": ["strength", "escapable_via"], "note": "strength = block | soft" },
          { "type": "guarded-by", "from": ["skill"], "to": ["hook"], "note": "runtime guard on a skill" },
          { "type": "gates", "from": ["hook"], "to": ["event", "tool"], "attributes": ["matcher"] },
          { "type": "conforms-to", "from": ["skill"], "to": ["rule"] }
        ],
        "meta_op": [
          { "type": "audits", "from": ["skill"], "to": ["skill", "hook"] },
          { "type": "scores", "from": ["skill"], "to": ["skill"] },
          { "type": "generates", "from": ["skill"], "to": ["skill", "hook", "rule"] },
          { "type": "refactors", "from": ["skill"], "to": ["skill"] },
          { "type": "ports", "from": ["skill"], "to": ["repo"] },
          { "type": "catalogs", "from": ["skill"], "to": ["skill", "agent", "hook", "rule"] }
        ],
        "lifecycle_egress": [
          { "type": "recommends", "from": ["skill"], "to": ["command"], "note": "proposes, does not execute" },
          { "type": "publishes-to", "from": ["skill"], "to": ["external-dep", "repo"], "note": "human-gated egress" }
        ],
        "vcs": [
          { "type": "parent-of", "from": ["branch"], "to": ["branch"], "note": "main -> epic -> task" },
          { "type": "isolates-into", "from": ["skill"], "to": ["worktree"] }
        ]
      },
      "consumers": {
        "ontology-lint": "enforces the integrity constraints below (block / warn)",
        "plugin-audit": "surfaces per-skill violations with fix proposals (rule enforcement coverage / SKILL<->odd agreement / routing resolution / agent validity)",
        "plugin-dev": "prevents at scaffold time (rule => layer3-trio default / one-source SKILL+odd / verify excludes-defers-to targets)"
      }
    },
    "doc-layer": {
      "applies_to": "the ai-context store's documents (decisions / docs / research / specs / knowledges) — a COMPLETE deterministic navigation ledger (metadata + relations only, NO content, NO embeddings). Navigated by structured filter (jq), not RAG-retrieved. Guarantees the agent is aware every document exists (no recall gap), then reads the chosen few deliberately.",
      "entities": [
        { "type": "document", "id_prefix": "doc:", "attributes": ["doc_type", "title", "author", "status"], "note": "doc_type = decision / research / spec / knowledge / Status / Design / Guide / Audit / Review / QA / Memo / Index" }
      ],
      "relations": [
        { "type": "references", "from": ["document"], "to": ["document"], "note": "doc -> related doc (from a decision's `related:` frontmatter); v1 emits entities only, references is a follow-up" }
      ]
    }
  },
  "integrity_constraints": [
    { "id": "IC1", "applies_to": "rule", "rule": "every rule either has a hook that `enforces` it, or declares `enforcement: advisory` explicitly (no silent please-only rules)", "consumers": ["ontology-lint", "plugin-audit", "plugin-dev"] },
    { "id": "IC2", "applies_to": "excludes|defers-to", "rule": "the target skill of an `excludes` / `defers-to` relation resolves to a real skill (generalization of plugin-audit Axis 15)", "consumers": ["ontology-lint", "plugin-audit"] },
    { "id": "IC3", "applies_to": "skill", "rule": "a skill's SKILL.md and odd.yaml agree on bucket path, autonomy, and scope", "consumers": ["ontology-lint", "plugin-audit", "plugin-dev"] },
    { "id": "IC4", "applies_to": "hook|script", "rule": "a `script` called a \"hook\" must be registered in hooks.json, or be explicitly distinguished as a scripts/ helper", "consumers": ["ontology-lint", "harness-audit"] },
    { "id": "IC5", "applies_to": "agent", "rule": "an agent's allowed-tools resolve, and its `invoked-by` is traceable to a skill or explicit caller", "consumers": ["ontology-lint", "plugin-audit"] }
  ]
}
